# ObserveX — Environment Configuration
# Copy to .env and fill in your values

# ── Core ──────────────────────────────────────────────────────────────────────
CLUSTER_NAME=production
APP_DOMAIN=observex.example.com

# ── Security (REQUIRED — change these before production) ────────────────────
JWT_SECRET=change-me-to-a-random-32-char-string-minimum
JWT_EXPIRY_HOURS=24
AGENT_TOKEN_SECRET=change-me-to-the-same-random-secret-on-gateway-and-ingestor
OBSERVEX_INGEST_TOKEN=change-me-prometheus-and-agent-static-ingest-token
# Docker Prometheus reads deployments/docker/configs/observex-token by default.
# Keep that file aligned with OBSERVEX_INGEST_TOKEN before production use.
OBSERVEX_ORG_ID=production
OBSERVEX_ENV=production
REQUIRE_AGENT_AUTH=true

# Internal service token (S1-06) — shared by api-gateway and processor.
# Preferred: put the token in a file and point OBSERVEX_INTERNAL_TOKEN_FILE at it.
# OBSERVEX_INTERNAL_TOKEN_FILE wins over OBSERVEX_INTERNAL_TOKEN. If the file is
# missing, unreadable, empty or too short, internal authentication fails closed
# and OBSERVEX_INTERNAL_TOKEN is NOT used as a fallback.
# Minimum 32 bytes after trimming whitespace (bytes, not characters).
# Generate:  openssl rand -hex 32
# Docker Compose reads the file secrets/internal-token (see docker-compose files).
# Never commit a real token.
OBSERVEX_INTERNAL_TOKEN_FILE=
OBSERVEX_INTERNAL_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=observex
POSTGRES_USER=observex
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DSN=postgres://observex:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}?sslmode=disable

# ── Storage backends ──────────────────────────────────────────────────────────
VICTORIA_URL=http://victoriametrics:8428
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
CLICKHOUSE_URL=http://clickhouse:8123
NEO4J_URL=bolt://neo4j:7687
REDIS_URL=redis://redis:6379

# ── Services ──────────────────────────────────────────────────────────────────
PROCESSOR_URL=http://processor:8080
AI_AGENT_URL=http://ai-agent:8081
INGESTOR_URL=http://ingestor:4318
PROFILING_URL=http://profiling:8084
DB_MONITOR_URL=http://db-monitor:8087

# ── Email (for user invitations) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=noreply@example.com
# SMTP_USER and SMTP_PASS set in docker secrets

# ── Integrations (optional) ───────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Observability (meta-monitoring) ──────────────────────────────────────────
LOG_LEVEL=info          # debug|info|warn|error
LOG_FORMAT=json         # json|console
METRICS_ENABLED=true
METRICS_MODE=prometheus   # prometheus|hybrid|native
ENABLE_NATIVE_METRICS=false

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_AI_REMEDIATION=true
AI_DRY_RUN=false         # set true to plan but not execute K8s actions
AI_REQUIRE_APPROVAL=true # require human approval for rollback/scale_down
ENABLE_EBPF=true         # disable on non-Linux or missing kernel headers
ENABLE_K8S=true          # disable if not running in Kubernetes

# ── Retention ────────────────────────────────────────────────────────────────
METRICS_RETENTION_MONTHS=12
LOGS_RETENTION_DAYS=30
TRACES_RETENTION_DAYS=7
